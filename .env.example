# Secrets and per-deployment values only. Settings live in config/environments/.
# Setup: docs/setup.md. Check: scripts/stack.sh doctor

# --- Models -------------------------------------------------------------------------
# Which models exist is config/litellm/models.yaml (copy models.example.yaml); it names this key.
LLM_API_KEY=
# OpenAI-compatible endpoint the gateway model calls
LLM_BASE_URL=
# The app's key to the gateway.
LITELLM_API_KEY=sk-mycel-dev

# --- Jira ---------------------------------------------------------------------------
# OAuth app for "Connect Jira". Callback: PUBLIC_BASE_URL/auth/jira/callback
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=

# --- Google ---------------------------------------------------------------------------
# OAuth client for "Connect Google" (calendar and mail).
# Callback: PUBLIC_BASE_URL/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Accounts -------------------------------------------------------------------------
# Fernet key for stored refresh tokens and own model keys. To rotate, put the new key first,
# comma, the old one: both open old values, new ones use the first.
TOKEN_ENCRYPTION_KEY=
# Comma-separated domains that may sign in (Google or emailed code). Empty = anyone.
REGISTRATION_ALLOWED_DOMAINS=
# Sign-in code mail. Gmail: smtp.gmail.com + https://myaccount.google.com/apppasswords
SMTP_HOST=
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=

# --- Stores (must match docker-compose.yml) -------------------------------------------
POSTGRES_PASSWORD=mycel
# The app connects as mycel_app (rows only, no DDL); migrations connect as the owner.
# On a dev machine leave the last two empty and everything runs as the owner.
DATABASE_URL=postgresql://mycel:mycel@localhost:5433/mycel
MIGRATION_DATABASE_URL=
MYCEL_APP_PASSWORD=
RABBITMQ_PASSWORD=mycel
RABBITMQ_URL=amqp://mycel:mycel@localhost:5672/
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_URL=redis://localhost:6380/0
S3_ACCESS_KEY=mycel
S3_SECRET_KEY=mycel-dev-secret

# --- Optional -------------------------------------------------------------------------
# Web search for the researcher.
TAVILY_API_KEY=
# Traces to Langfuse.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Only when monitoring.grafana.anonymous is false.
GRAFANA_ADMIN_USER=
GRAFANA_ADMIN_PASSWORD=
