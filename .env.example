# PostgreSQL - transactional state, holds all three schemas: raw / silver / gold
DATABASE_URL=postgresql://mycel:mycel@localhost:5432/mycel

# RabbitMQ - job queue
RABBITMQ_URL=amqp://mycel:mycel@localhost:5672/
RABBITMQ_JOB_QUEUE=jobs

# Redis - agent event stream to the browser, and the holding area a finished report waits
# in until the caller polls for it. Neither is durable: losing it costs a rerun.
REDIS_URL=redis://localhost:6379/0
# How long a job id stays good for. Past this the GET returns 404 like an id that never
# existed, because there is nothing left to tell them apart.
RESULT_TTL_SECONDS=3600

# What one queued report may spend before the worker refuses it. Billed against the
# worker, not the API - the run happens there.
JOB_CEILING_USD=0.50

# Qdrant - vector store for knowledge base search
QDRANT_URL=http://localhost:6333

# LLM
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Local model endpoint, only needed with the local-llm profile enabled
LOCAL_LLM_BASE_URL=http://localhost:8001/v1

# Tools that reach outside the process. Only the researcher needs this one; without it
# every other agent still runs.
TAVILY_API_KEY=

# Observability - agent runs go straight to Langfuse Cloud over OTLP HTTP
OTEL_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://jp.cloud.langfuse.com
OTEL_SERVICE_NAME=mycel
# Leave empty for Langfuse. Set it only with the monitoring profile up, which sends spans
# to the collector instead - a full path, not a host: http://localhost:4318/v1/traces
OTEL_EXPORTER_OTLP_ENDPOINT=

# Providers - fill in when enabling the matching connector
SLACK_BOT_TOKEN=
GMAIL_CREDENTIALS_PATH=
CONFLUENCE_BASE_URL=
CONFLUENCE_API_TOKEN=

# Environment: dev | staging | prod
MYCEL_ENV=dev
