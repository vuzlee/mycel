# Copy to .env and fill in the blanks. Secrets and per-machine settings only;
# non-secret, versioned config lives in config/environments/*.yaml.

# --- Runtime ---
MYCEL_ENV=dev
LOG_LEVEL=INFO

# --- Postgres ---
# The container reads these; DATABASE_URL is what the app reads. Keep them in step.
POSTGRES_USER=mycel
POSTGRES_PASSWORD=mycel
POSTGRES_DB=mycel
# Plain postgresql://; engine.py swaps in the async driver, alembic reads it as-is.
DATABASE_URL=postgresql://mycel:mycel@localhost:5433/mycel
# Per process. Multiply by uvicorn workers plus consumer count.
DB_POOL_SIZE=5

# --- RabbitMQ ---
RABBITMQ_USER=mycel
RABBITMQ_PASSWORD=mycel
RABBITMQ_URL=amqp://mycel:mycel@localhost:5672/

# --- Redis ---
# db 0 holds in-flight state under noeviction; db 1 is the cache and may evict.
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_URL=redis://localhost:6379/1
# Past this a job id returns 404, like one that never existed.
RESULT_TTL_SECONDS=3600
# A client that falls further behind than this sees a gap in seq and says so.
EVENT_STREAM_MAX_EVENTS=1000

# --- LLM ---
# A run needs the key its model spec asks for and no other.
# Comma-separated, and each key is a separate account with its own quota: three Gemini
# keys are three free tiers, not one. They are used in turn, and one refused for the day
# is set aside until midnight UTC.
#
# One provider. Anthropic had a key here until it turned out no agent ever selected a
# Claude model, and a variable for something nothing reads is a promise the code does not
# keep.
GEMINI_API_KEYS=
# Only with the local-llm profile up.
LOCAL_LLM_BASE_URL=http://localhost:8001/v1
# Spend ceiling for one queued job, charged to the worker.
JOB_CEILING_USD=0.50

# --- Observability ---
OTEL_ENABLED=false
OTEL_SERVICE_NAME=mycel
LANGFUSE_BASE_URL=https://jp.cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Leave empty for Langfuse. Set only with the monitoring profile up, and give a full
# path, not a host: http://localhost:4318/v1/traces
OTEL_EXPORTER_OTLP_ENDPOINT=

# Whether a span carries the prompt sent and the text that came back, as well as the
# model, tokens and cost it always carries.
#
# Turning this on sends real data to a third party: the question a user typed, and the
# internal figures that answered it. On in development, where reading the SQL an agent
# wrote is the point of having a trace at all. Off anywhere else unless somebody decided.
OTEL_CAPTURE_CONTENT=false
# Where the worker and the scheduler serve /metrics. The api serves it on the port it
# already has. /metrics has no authentication - Prometheus carries no session token - so
# the interface this binds to is the only thing keeping it private. Loopback on a laptop;
# docker-compose.yml sets 0.0.0.0 inside the containers, where that means the compose
# network and the port is not published.
METRICS_HOST=127.0.0.1
# The scheduler listens one above this.
METRICS_PORT=9100

# --- Sources ---
# Jira is the source of record for what the work *is*: epic, story, task, who owns it,
# what it was estimated at, when it is due. Free plan, 10 users, full REST API.
#
# The token is a personal API token, not OAuth: id.atlassian.com -> Manage account ->
# Security -> Create and manage API tokens. It authenticates as the account that made it
# and inherits that account's permissions.
#
# Note it expires after exactly one year, silently and with no programmatic renewal. A
# 401 out of nowhere twelve months from now is this, not a bug.
JIRA_BASE_URL=https://your-site.atlassian.net
# The Atlassian account the token belongs to. Basic auth sends this as the username.
JIRA_EMAIL=
JIRA_API_TOKEN=
# Which project to sync, by key — the prefix on every issue id, e.g. MYC in MYC-14.
# Empty means every project the token can see, which on a personal site is the same thing.
JIRA_PROJECT_KEY=

# Where a link out of this deployment points. Nothing here has a page to be relative to,
# so this is the only place the deployment's own address is written down.
PUBLIC_BASE_URL=http://localhost:8000

# How often the scheduler syncs. Jira keeps its history, so a missed pass costs nothing
# but freshness — this is a comfort setting, not a data-loss boundary.
SYNC_INTERVAL_SECONDS=900

# --- Tools ---
# Only the researcher needs this; every other agent runs without it.
TAVILY_API_KEY=

# --- Search over gold (batch 008) ---
# Where Qdrant answers. EMPTY DISABLES SEARCH, and that is the switch: `rag_search` is not
# offered to the model at all without it, because a tool the model can see is a tool it
# will call, and one that fails every time costs a turn to learn that.
#   docker compose --profile vectors up -d
QDRANT_URL=
# The embedding model, run on this machine - no API, no quota, no bill. Its name is part of
# the collection name, because the dimension belongs to the model: changing it means a new
# collection and a full reindex, and there is no way to mix two vector spaces in one.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Where the downloaded ONNX weights live, ~130 MiB. Named so a container can mount it and
# not fetch them again on every start.
EMBEDDING_CACHE_DIR=.cache/fastembed

# Grafana's login, read only when monitoring.grafana.anonymous is false. On minikube it is
# true and these are unused; any hostname that actually resolves wants them set, because
# Grafana admin includes editing the datasources. The pod refuses to start if they are
# missing rather than falling back to admin/admin.
GRAFANA_ADMIN_USER=
GRAFANA_ADMIN_PASSWORD=

# --- Providers ---
# Gmail, read over IMAP. Needs 2FA on, then myaccount.google.com/apppasswords ->
# create -> 16 characters, spaces removed. Also enable IMAP in Gmail settings.
# Not a scoped token: this reaches the whole mailbox. Revoke on that same page.
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# --- Google Calendar, read and written as the person asking ---
# Per-user consent, not a service account: the only calendar worth reading is the one the
# person asking already lives in. Leave these blank and the settings screen says the
# calendar cannot be connected; everything else runs unchanged.
#
# console.cloud.google.com -> APIs & Services -> Credentials -> Create credentials ->
# OAuth client ID -> Web application. Under "Authorised redirect URIs" add exactly
# PUBLIC_BASE_URL + /auth/google/callback, or Google refuses the round. Then enable the
# Google Calendar API for the same project.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# The key the stored refresh token is encrypted with. A refresh token opens one person's
# calendar until they revoke it, so it is never written to Postgres in the clear — and a
# deployment without this key refuses to connect an account rather than keeping one
# readably. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Rotating it disconnects every account, which people fix by connecting again.
GOOGLE_TOKEN_KEY=
