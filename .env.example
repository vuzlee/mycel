# Keys only. Settings live in config/environments/. Check with: scripts/stack.sh doctor

# --- Required ---
# Comma-separated; each key is its own free tier.
GEMINI_API_KEYS=
CLAUDE_API_KEYS=
LITELLM_API_KEY=sk-mycel-dev
# The sync's own Jira identity: a service account with Browse on each project to sync.
# docs/setup.md. Write the token's last day too (YYYY-MM-DD); doctor warns a month before.
JIRA_SERVICE_TOKEN=
JIRA_CLOUD_ID=
JIRA_SERVICE_TOKEN_EXPIRES=
# Atlassian OAuth app, for "Connect Jira". Callback: PUBLIC_BASE_URL/auth/jira/callback
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=
# Fernet key for stored refresh tokens. Rotating it disconnects every account.
TOKEN_ENCRYPTION_KEY=
# Empty = anyone who reaches the URL can register.
REGISTRATION_INVITE_CODE=

# --- Stores (must match docker-compose.yml) ---
POSTGRES_PASSWORD=mycel
# The running app connects as mycel_app, which cannot change the schema; migrations
# connect as the owner. On a dev machine both may stay the owner: leave the two below empty.
DATABASE_URL=postgresql://mycel:mycel@localhost:5433/mycel
MIGRATION_DATABASE_URL=
MYCEL_APP_PASSWORD=
RABBITMQ_PASSWORD=mycel
RABBITMQ_URL=amqp://mycel:mycel@localhost:5672/
S3_ACCESS_KEY=mycel
S3_SECRET_KEY=mycel-dev-secret
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_URL=redis://localhost:6379/1

# --- Optional ---
TAVILY_API_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Callback: PUBLIC_BASE_URL/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Password reset mail. Gmail: smtp.gmail.com + an app password,
# https://myaccount.google.com/apppasswords
SMTP_HOST=
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=
# Only when monitoring.grafana.anonymous is false.
GRAFANA_ADMIN_USER=
GRAFANA_ADMIN_PASSWORD=
