# PostgreSQL - state giao dịch, chứa cả 3 schema raw / silver / gold
DATABASE_URL=postgresql://mycel:mycel@localhost:5432/mycel

# Kafka - hàng đợi job
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_JOB_TOPIC=jobs
KAFKA_CONSUMER_GROUP=mycel-worker

# Qdrant - vector store cho tìm kiếm knowledge base
QDRANT_URL=http://localhost:6333

# MinIO - object store cho file lớn (S3 API)
# Đổi sang S3 thật thì chỉ đổi endpoint, không sửa code
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=mycel
S3_SECRET_KEY=
S3_BUCKET_RAW=mycel-raw
S3_BUCKET_REPORTS=mycel-reports

# LLM
ANTHROPIC_API_KEY=
# Endpoint model local, chỉ cần khi bật profile local-llm
LOCAL_LLM_BASE_URL=http://localhost:8001/v1

# Observability - app chỉ gửi OTLP tới collector, không gửi thẳng tới Tempo
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=mycel
# Log in ra stdout, Promtail gom về Loki - không có biến nào trỏ tới Loki ở đây

# Provider - điền khi bật connector tương ứng
SLACK_BOT_TOKEN=
GMAIL_CREDENTIALS_PATH=
CONFLUENCE_BASE_URL=
CONFLUENCE_API_TOKEN=

# Môi trường: dev | staging | prod
MYCEL_ENV=dev
