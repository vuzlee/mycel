# Copy to .env and fill in the blanks. Secrets and per-machine settings only;
# non-secret, versioned config lives in config/environments/*.yaml.

# --- Runtime ---
MYCEL_ENV=dev
LOG_LEVEL=INFO

# --- Postgres ---
# The container reads these; DATABASE_URL is what the app reads. Keep them in step.
POSTGRES_USER=mycel
POSTGRES_PASSWORD=mycel
POSTGRES_DB=mycel
# Plain postgresql://; engine.py swaps in the async driver, alembic reads it as-is.
DATABASE_URL=postgresql://mycel:mycel@localhost:5432/mycel
# Per process. Multiply by uvicorn workers plus consumer count.
DB_POOL_SIZE=5

# --- RabbitMQ ---
RABBITMQ_USER=mycel
RABBITMQ_PASSWORD=mycel
RABBITMQ_URL=amqp://mycel:mycel@localhost:5672/
RABBITMQ_JOB_QUEUE=jobs

# --- Redis ---
# db 0 holds in-flight state under noeviction; db 1 is the cache and may evict.
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_URL=redis://localhost:6379/1
# Past this a job id returns 404, like one that never existed.
RESULT_TTL_SECONDS=3600
# A client that falls further behind than this sees a gap in seq and says so.
EVENT_STREAM_MAX_EVENTS=1000

# --- LLM ---
# A run needs the key its model spec asks for and no other.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Only with the local-llm profile up.
LOCAL_LLM_BASE_URL=http://localhost:8001/v1
# Spend ceiling for one queued job, charged to the worker.
JOB_CEILING_USD=0.50

# --- Sources ---
# Jira is the source of record for what the work *is*: epic, story, task, who owns it,
# what it was estimated at, when it is due. Free plan, 10 users, full REST API.
#
# The token is a personal API token, not OAuth: id.atlassian.com -> Manage account ->
# Security -> Create and manage API tokens. It authenticates as the account that made it
# and inherits that account's permissions.
#
# Note it expires after exactly one year, silently and with no programmatic renewal. A
# 401 out of nowhere twelve months from now is this, not a bug.
JIRA_BASE_URL=https://your-site.atlassian.net
# The Atlassian account the token belongs to. Basic auth sends this as the username.
JIRA_EMAIL=
JIRA_API_TOKEN=
# Which project to sync, by key — the prefix on every issue id, e.g. MYC in MYC-14.
# Empty means every project the token can see, which on a personal site is the same thing.
JIRA_PROJECT_KEY=

# Where a link out of this deployment points. Nothing here has a page to be relative to,
# so this is the only place the deployment's own address is written down.
PUBLIC_BASE_URL=http://localhost:8000

# How often the scheduler syncs. Jira keeps its history, so a missed pass costs nothing
# but freshness — this is a comfort setting, not a data-loss boundary.
SYNC_INTERVAL_SECONDS=900

# --- Tools ---
# Only the researcher needs this; every other agent runs without it.
TAVILY_API_KEY=

# --- Vectors ---
QDRANT_URL=http://localhost:6333

# --- Observability ---
OTEL_ENABLED=false
LANGFUSE_BASE_URL=https://jp.cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
OTEL_SERVICE_NAME=mycel
# Leave empty for Langfuse. Set only with the monitoring profile up, and give a full
# path, not a host: http://localhost:4318/v1/traces
OTEL_EXPORTER_OTLP_ENDPOINT=

# --- Providers ---
# Fill in when enabling the matching connector.
SLACK_BOT_TOKEN=
CONFLUENCE_BASE_URL=
CONFLUENCE_API_TOKEN=

# Gmail, read over IMAP. Needs 2FA on, then myaccount.google.com/apppasswords ->
# create -> 16 characters, spaces removed. Also enable IMAP in Gmail settings.
# Not a scoped token: this reaches the whole mailbox. Revoke on that same page.
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# The calendar deadlines are written to. Calendar is an output, not a source: Mycel
# writes due dates there so they can be read on a phone, and never reads work back out.
# Give it a calendar of its own rather than "primary" — a bug then writes junk into a
# calendar nobody reads by hand, and clearing it is deleting one calendar.
# Settings -> that calendar -> Integrate calendar -> Calendar ID.
GOOGLE_CALENDAR_ID=
# Service account key file, kept outside the repo. IAM -> Service Accounts ->
# create -> Keys -> Add key -> JSON. Then share that calendar with the account's
# own email, permission "Make changes to events", or it sees nothing.
GOOGLE_SERVICE_ACCOUNT_JSON=
