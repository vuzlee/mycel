# PostgreSQL - transactional state, holds all three schemas: raw / silver / gold
DATABASE_URL=postgresql://mycel:mycel@localhost:5432/mycel

# Kafka - job queue
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_JOB_TOPIC=jobs
KAFKA_CONSUMER_GROUP=mycel-worker

# Qdrant - vector store for knowledge base search
QDRANT_URL=http://localhost:6333

# MinIO - object store for large files (S3 API)
# Moving to real S3 is an endpoint change, no code change
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=mycel
S3_SECRET_KEY=
S3_BUCKET_RAW=mycel-raw
S3_BUCKET_REPORTS=mycel-reports

# LLM
ANTHROPIC_API_KEY=
# Local model endpoint, only needed with the local-llm profile enabled
LOCAL_LLM_BASE_URL=http://localhost:8001/v1

# Observability - the app only ships OTLP to the collector, never straight to Tempo
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=mycel
# Logs go to stdout and Promtail ships them to Loki - nothing here points at Loki

# Providers - fill in when enabling the matching connector
SLACK_BOT_TOKEN=
GMAIL_CREDENTIALS_PATH=
CONFLUENCE_BASE_URL=
CONFLUENCE_API_TOKEN=

# Environment: dev | staging | prod
MYCEL_ENV=dev
