# Keys and per-machine values. NEVER COMMITTED.
#
# The rule: what must never reach git lives here, everything else lives in
# `config/environments/base.yaml` — intervals, hosts, log levels, feature switches. That
# file IS committed, on purpose: changing a setting becomes a commit with a history and a
# reviewer, rather than a silent edit on one machine nobody can explain six months later.
#
# NOTHING BELOW IS REQUIRED. Every setting has a default and every feature turns itself off
# without its key — a deployment with none of these still starts and still answers. What it
# cannot do is reach Jira, call a model, or connect a calendar.
#
#   scripts/stack.sh doctor      says which of these are missing, and what each one costs
#
# FOUR of the lines below are worth your attention; the rest already work. They are in the
# first block, under a line saying so.
#
# The store URLs look like an exception to the rule and are not: postgresql://user:pw@host
# is a password with an address attached.

# ============================================================================
# FILL THESE IN. Everything below the second line already works.
# ============================================================================

# The model. Without it nothing can be asked a question.
# Comma-separated, and each key is a separate account with its own quota: three Gemini keys
# are three free tiers, not one. Used in turn, and one refused for the day is set aside
# until midnight UTC.
GEMINI_API_KEYS=

# Jira, the source. Without it the dashboard is empty.
# id.atlassian.com -> Manage account -> Security -> Create and manage API tokens.
# One account's token for the WHOLE deployment: everyone reads the same board. Batch 060
# replaces it with per-person OAuth.
JIRA_EMAIL=
JIRA_API_TOKEN=

# Who may register. EMPTY MEANS ANYONE WHO CAN REACH THE URL.
# Right for a laptop on localhost, wrong the moment the app is on a company network. This
# is the only lock on the front door; the domain allowlist beside it is in base.yaml,
# because a list of domains is not a secret and a shared code is.
REGISTRATION_INVITE_CODE=

# ============================================================================
# ALREADY WORKS. Touch only if the defaults do not suit the machine.
# ============================================================================

# Which environment. Picks config/environments/<name>.yaml.
MYCEL_ENV=dev

# --- Stores. These defaults match docker-compose.yml; change them together ---
POSTGRES_USER=mycel
POSTGRES_PASSWORD=mycel
POSTGRES_DB=mycel
# Plain postgresql://; engine.py swaps in the async driver, alembic reads it as-is.
DATABASE_URL=postgresql://mycel:mycel@localhost:5433/mycel
RABBITMQ_USER=mycel
RABBITMQ_PASSWORD=mycel
RABBITMQ_URL=amqp://mycel:mycel@localhost:5672/
# db 0 holds in-flight state under noeviction; db 1 is the cache and may evict.
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_URL=redis://localhost:6379/1

# --- Optional. Each one missing turns off exactly one thing ---
# Web search, for the researcher only.
TAVILY_API_KEY=
# Reading mail headers. An app password is a FULL-ACCESS password with no narrower scope
# available, which is why the headers-only discipline is enforced in sources/gmail.py.
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
# Traces. Without them the app runs and nothing records what it did.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Sending mail, which is the only way a forgotten password can be recovered.
SMTP_USERNAME=
SMTP_PASSWORD=

# --- Google Calendar, read and written as the person asking ---
# console.cloud.google.com -> Credentials -> OAuth client ID -> Web application.
# Authorised redirect URI must be exactly PUBLIC_BASE_URL + /auth/google/callback.
# Leave blank and the settings screen says the calendar cannot be connected.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Encrypts the stored refresh token. A refresh token opens one person's calendar until
# they revoke it, so a database dump must not be a list of calendars. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Rotating it disconnects every account, which people fix by connecting again.
GOOGLE_TOKEN_KEY=

# --- Grafana, only when monitoring.grafana.anonymous is false ---
# On minikube it is true and these are unused. Any hostname that actually resolves wants
# them set: Grafana admin includes editing the datasources.
GRAFANA_ADMIN_USER=
GRAFANA_ADMIN_PASSWORD=
