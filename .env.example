# Secrets and per-deployment values. Settings: config/environments/. Check: scripts/stack.sh doctor

# --- Default model (required) — the model everyone gets; own models are added in the app
DEFAULT_MODEL_API_KEY=
# The gateway's admin key: only the gateway holds it.
LITELLM_MASTER_KEY=sk-mycel-dev
# The app's scoped key: scripts/stack.sh gateway-key. Never the master key.
LITELLM_API_KEY=

# --- Stores (required) — must match docker-compose.yml
# URLs are built from these. DATABASE_URL, RABBITMQ_URL override them only for a store reached another way.
POSTGRES_PASSWORD=mycel
RABBITMQ_PASSWORD=mycel
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_URL=redis://localhost:6380/0
S3_ACCESS_KEY=mycel
S3_SECRET_KEY=mycel-dev-secret
# Prod: set it and the app connects as mycel_app (rows only, no DDL).
MYCEL_APP_PASSWORD=

# --- Accounts (required) — Fernet key for stored tokens; rotate as "new,old"
TOKEN_ENCRYPTION_KEY=

# --- Sign-in (at least one: SMTP or Google)
# Allowed email domains, comma-separated. Empty = anyone.
REGISTRATION_ALLOWED_DOMAINS=
SMTP_HOST=
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=

# --- Plugin apps (optional) — each person connects their own account in the app
# Callback: PUBLIC_BASE_URL/auth/jira/callback
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=
# Calendar, mail, Google sign-in. Callback: PUBLIC_BASE_URL/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Optional
TAVILY_API_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=
GRAFANA_ADMIN_USER=
GRAFANA_ADMIN_PASSWORD=
