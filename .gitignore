# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/

# Tooling
.mypy_cache/
.ruff_cache/
.pytest_cache/

# Environment - never commit
.env
config/*-local.ini

# Local assistant/editor state, not part of the project
.claude/

# OS / editor
.DS_Store
.idea/
.vscode/

# Scratch notes, never pushed.
notes/

# Frontend: installed, and built into the image.
web/node_modules/
web/dist/
.env.bak.*

# Host-process pids and logs from scripts/stack.sh
.run/

# One-off Jira maintenance scripts. Not part of the app.
.jira/

# Hand-run scratch scripts: real models, real money, no CI.
scripts/smoke/

# The maintainer's own tools: seeding and sprinting their Jira board, recording the README
# demo, trying one document. Kept on their machine, not part of the repo.
scripts/tools/seed_jira.py
scripts/tools/_jira_auth.py
scripts/tools/assign_sprint.py
scripts/tools/record_demo.py
scripts/tools/try_ask.py
scripts/tools/try_ingest.py

# Coverage data, written by `pytest --cov`.
.coverage

# Every still and take from a demo recording — working material. The one the README
# shows is uploaded to GitHub's CDN by hand and lives at a user-attachments URL, so
# nothing from here is ever committed.
assets/demo/

# The embedding model's ONNX weights, fetched on first use. ~130 MiB, and a build
# artefact rather than source: EMBEDDING_CACHE_DIR points here.
.cache/

# A timestamped file per retrieval run; the summary that matters goes in the batch note.
evals/rag/results/retrieval-*.json
